Созданик вьюшки
CREATE VIEW europian_capitals AS
SELECT cit.city_name, c.country_name, cit.population
FROM countries c
INNER JOIN continents con ON c.continent_id = con.continent_id
INNER JOIN cities cit ON c.country_id = cit.country_id
WHERE continent_name = 'Europe' AND is_capital;

